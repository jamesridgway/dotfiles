#!/bin/bash
# Stow every package in this repo into $HOME, then install third-party plugins.
#
# --no-folding keeps directories real and links only individual files, so
# Omarchy can keep writing its own files into ~/.config/omarchy/ without them
# landing in this repo.

set -euo pipefail

cd "$(dirname "$0")"

force_setup=0
for arg in "$@"; do
  case "$arg" in
    --force-setup) force_setup=1 ;;
    -h | --help)
      echo "Usage: ./bootstrap [--force-setup]"
      echo
      echo "  --force-setup  Run the scripts in setup/ even if nothing changed."
      exit 0
      ;;
    *)
      echo "Unknown option: $arg" >&2
      echo "Usage: ./bootstrap [--force-setup]" >&2
      exit 1
      ;;
  esac
done

# ---------------------------------------------------------------------------
# Output helpers
#
# Colour only when stdout is a terminal. A redirect, a pipe or a CI job gets
# clean text with no escape codes. NO_COLOR is honoured -- see no-color.org.
# ---------------------------------------------------------------------------

if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
  BOLD=$'\e[1m'; DIM=$'\e[2m'; RESET=$'\e[0m'
  RED=$'\e[31m'; GREEN=$'\e[32m'; YELLOW=$'\e[33m'; BLUE=$'\e[34m'
else
  BOLD=''; DIM=''; RESET=''
  RED=''; GREEN=''; YELLOW=''; BLUE=''
fi

problems=0

rule()    { printf '%s\n' "${DIM}────────────────────────────────────────────────────${RESET}"; }
heading() { printf '\n%s\n' "${BOLD}${BLUE}▸ $*${RESET}"; }
ok()      { printf '  %s\n' "${GREEN}✓${RESET} $*"; }
work()    { printf '  %s\n' "${YELLOW}→${RESET} $*"; }
info()    { printf '  %s\n' "${DIM}$*${RESET}"; }
warn()    { printf '  %s\n' "${YELLOW}!${RESET} $*" >&2; }
bad()     { printf '  %s\n' "${RED}✗${RESET} $*" >&2; problems=$((problems + 1)); }

# A hard stop: report, then leave without touching anything.
die() {
  printf '\n  %s %s\n\n' "${RED}✗${RESET}" "${BOLD}$1${RESET}" >&2
  shift
  for line in "$@"; do printf '    %s\n' "${DIM}$line${RESET}" >&2; done
  if [[ $# -gt 0 ]]; then printf '\n' >&2; fi
  exit 1
}

printf '\n%s\n' "${BOLD}  dotfiles${RESET}${DIM} · GNU Stow · Omarchy 4${RESET}"
rule

# ---------------------------------------------------------------------------
# Preflight
# ---------------------------------------------------------------------------

heading "Preflight"

if ! command -v stow >/dev/null; then
  die "GNU Stow is not installed." "Install it with:" "sudo pacman -S --needed stow"
fi
ok "stow $(stow --version | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)"

# Every top-level directory is a stow package, except the ones named here.
# Files at the top level (plugins.txt, README.md) are skipped by the glob.
#
# setup/ holds scripts that change the system rather than $HOME, so it must
# never be stowed. Adding it to a machine's ~ would be meaningless at best.
not_packages=(setup)

packages=()
for dir in */; do
  dir="${dir%/}"
  skip=0
  for excluded in "${not_packages[@]}"; do
    [[ $dir == "$excluded" ]] && skip=1
  done
  (( skip )) || packages+=("$dir")
done

if [[ ${#packages[@]} -eq 0 ]]; then
  die "No packages found." "Run this from the root of the dotfiles repo."
fi
ok "${#packages[@]} packages: ${DIM}${packages[*]}${RESET}"

# ssh refuses to use a config file that is group- or world-writable, and git
# records only the executable bit -- a fresh clone lands at 644. Fix the mode on
# the file in this repo, since the symlink resolves through to it.
if [[ -f ssh/.ssh/config ]]; then
  chmod 600 ssh/.ssh/config
  ok "ssh/.ssh/config mode 600"
fi

# ---------------------------------------------------------------------------
# Symlinks
# ---------------------------------------------------------------------------

heading "Symlinks"

# Show what would happen, so conflicts surface before anything is written.
# stow sends its plan, its conflict report and its simulation banner all to
# stderr, so capture that rather than letting it leak straight to the terminal.
# A conflict exits non-zero; a clean run exits 0.
dry_run() { stow -n -v --no-folding -t "$HOME" "${packages[@]}" 2>&1; }

# A conflicting file whose contents already match the repo is moved aside
# rather than deleted, and put back if this run ends before stow has made its
# symlink -- an abort at either prompt, or a stow failure, must not cost a
# working ~/.ssh/config its contents.
backup_dir=""
replaced=()
stow_applied=0

restore_replaced() {
  local t
  for t in "${replaced[@]}"; do
    if [[ -e "$backup_dir/$t" && ! -e "$HOME/$t" ]]; then
      mkdir -p "$HOME/$(dirname "$t")"
      mv "$backup_dir/$t" "$HOME/$t"
    fi
  done
}

if ! plan=$(dry_run); then
  # A real file sits where a symlink should go. Stow's report names the file
  # but not what to do about it, and its wording moved between releases, so
  # parse out each target and decide: a file that matches the repo's copy byte
  # for byte can simply become the symlink; anything else needs a human.
  re_since='over existing target (.+) since neither a link'           # stow >= 2.4
  re_colon='existing target is neither a link nor a directory: (.+)$' # stow <= 2.3
  re_bullet='^[[:space:]]*\*[[:space:]]*(.*)$'

  identical=() differing=() unresolvable=()
  while IFS= read -r line; do
    if [[ $line =~ $re_since || $line =~ $re_colon ]]; then
      target="${BASH_REMATCH[1]}"
    elif [[ $line =~ $re_bullet ]]; then
      unresolvable+=("${BASH_REMATCH[1]}") # a conflict this script does not understand
      continue
    else
      continue # stow's banner and summary lines
    fi

    repo_file=""
    for pkg in "${packages[@]}"; do
      [[ -f "$pkg/$target" ]] && repo_file="$pkg/$target"
    done

    if [[ -z $repo_file ]]; then
      unresolvable+=("$target: no package in this repo provides it")
    elif cmp -s "$repo_file" "$HOME/$target"; then
      identical+=("$target|$repo_file")
    else
      differing+=("$target|$repo_file")
    fi
  done <<<"$plan"

  if [[ ${#differing[@]} -gt 0 || ${#unresolvable[@]} -gt 0 ]]; then
    printf '\n  %s %s\n\n' "${RED}✗${RESET}" "${BOLD}Conflicts found. Nothing has been changed.${RESET}" >&2
    for entry in "${differing[@]}"; do
      target="${entry%%|*}" repo_file="${entry#*|}"
      printf '    %s %s\n' "${RED}${BOLD}≠${RESET}" "${BOLD}~/$target${RESET}${DIM} differs from ${RESET}$repo_file" >&2
      printf '        %s\n' "${DIM}diff ~/$target $repo_file${RESET}" >&2
    done
    for entry in "${unresolvable[@]}"; do
      printf '    %s %s\n' "${RED}${BOLD}✗${RESET}" "$entry" >&2
    done
    for entry in "${identical[@]}"; do
      target="${entry%%|*}"
      printf '    %s %s\n' "${GREEN}=${RESET}" "~/$target${DIM} matches the repo, and is replaced automatically once the files above are dealt with${RESET}" >&2
    done
    printf '\n    %s\n' "${DIM}For each ${RESET}${RED}≠${RESET}${DIM} file, keep one side or the other:${RESET}" >&2
    printf '      %s\n' "${DIM}the repo's version:   delete the file, then run ./bootstrap again${RESET}" >&2
    printf '      %s\n' "${DIM}this machine's file:  stow --adopt --no-folding -t \"\$HOME\" <package> && git diff${RESET}" >&2
    printf '\n' >&2
    exit 1
  fi

  info "${#identical[@]} conflicting file(s) already match this repo byte for byte:"
  printf '\n'
  for entry in "${identical[@]}"; do
    target="${entry%%|*}" repo_file="${entry#*|}"
    printf '    %s %s %s\n' "${GREEN}=${RESET}" "${BOLD}~/$target${RESET}" "${DIM}same as $repo_file${RESET}"
  done
  printf '\n'
  read -rp "  ${BOLD}Replace with symlinks?${RESET} [y/N] " reply
  if [[ ${reply,,} != y ]]; then
    printf '\n  %s\n\n' "${YELLOW}!${RESET} Aborted, nothing changed."
    exit 0
  fi

  backup_dir=$(mktemp -d)
  trap 'if [[ $stow_applied -eq 0 ]]; then restore_replaced; fi; rm -rf "$backup_dir"' EXIT
  for entry in "${identical[@]}"; do
    target="${entry%%|*}"
    mkdir -p "$backup_dir/$(dirname "$target")"
    mv "$HOME/$target" "$backup_dir/$target"
    replaced+=("$target")
  done

  if ! plan=$(dry_run); then
    printf '%s\n' "$plan" | sed 's/^/    /' >&2
    die "stow still reports conflicts. The replaced files have been put back."
  fi
  ok "moved ${#replaced[@]} file(s) aside; their symlinks are in the plan below"
fi

# Drop stow's "in simulation mode" banner. It describes the dry run rather than
# this repo, and when everything is already linked it is the *only* output --
# which would otherwise leave us prompting to apply a plan that is empty.
plan=$(printf '%s\n' "$plan" | grep -v '^WARNING: in simulation mode' || true)

if [[ -z ${plan//[[:space:]]/} ]]; then
  ok "already stowed, nothing to do"
else
  links=$(printf '%s\n' "$plan" | grep -c '^LINK:' || true)
  dirs=$(printf '%s\n' "$plan" | grep -c '^MKDIR:' || true)
  info "$links links and $dirs directories to create:"
  printf '\n'
  printf '%s\n' "$plan" | sed "s/^/    ${DIM}/;s/\$/${RESET}/"
  printf '\n'
  read -rp "  ${BOLD}Apply?${RESET} [y/N] " reply
  if [[ ${reply,,} != y ]]; then
    if [[ ${#replaced[@]} -gt 0 ]]; then
      printf '\n  %s\n\n' "${YELLOW}!${RESET} Aborted; the files moved aside were put back."
    else
      printf '\n  %s\n\n' "${YELLOW}!${RESET} Aborted, nothing changed."
    fi
    exit 0
  fi
  printf '\n'
  if ! output=$(stow -v --no-folding -t "$HOME" "${packages[@]}" 2>&1); then
    printf '%s\n' "$output" | sed 's/^/    /' >&2
    die "stow failed. Some links may not have been made."
  fi
  printf '%s\n' "$output" | sed "s/^/    ${DIM}/;s/\$/${RESET}/"
  stow_applied=1
  ok "stowed $links files"
fi

# ---------------------------------------------------------------------------
# Packages
#
# Tools that the configuration in this repo assumes, but that no package
# depends on. A missing one is reported and does not stop the run, because
# every symlink is already in place by this point and the desktop works
# without any of them.
#
# hyprmon arranges monitors in a TUI. The arrangement itself lives in
# hypr/monitors.lua and applies with or without it -- read the note at the foot
# of that file before you use it, because HyprMon writes rules that override
# the ones this repo tracks.
#
# todoist is what Super + Shift + T opens. hypr/bindings.lua names the desktop
# entry that this package installs, so on a machine without the package the key
# does nothing at all and Hyprland reports no error for it.
#
# networkmanager supplies nmcli, which the VPN work uses. Nothing on this
# system depends on the package -- pacman reports `Required By: None` -- so it
# can genuinely be absent, and it belongs on this list with the others.
# ---------------------------------------------------------------------------

heading "Packages"

# pacman cannot build from the AUR. Find a helper that can. yay ships with
# Omarchy; paru is here for a machine set up by hand.
aur_helper() {
  local candidate
  for candidate in yay paru; do
    if command -v "$candidate" >/dev/null; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

# ensure_package <pacman-name> <command-it-provides>
#
# Test for the command rather than for the package, because the command is what
# the configuration actually needs, and because `pacman -Q` is slower.
#
# The install is NOT run with --noconfirm. An AUR build asks you to read a
# PKGBUILD, and sudo asks for a password; both need the terminal, so the output
# is left alone rather than captured the way the plugin output is.
ensure_package() {
  local pkg="$1" bin="$2" helper source
  local -a installer

  if command -v "$bin" >/dev/null; then
    ok "$pkg ${DIM}already installed${RESET}"
    return 0
  fi

  # An AUR helper installs from the repos too, so prefer it whenever there is
  # one. Without a helper, a package that is in the repos can still come from
  # pacman, which is the case for networkmanager. Only an AUR package --
  # hyprmon-bin, todoist-appimage -- really needs the helper.
  if helper=$(aur_helper); then
    installer=("$helper" -S --needed)
    source="$helper"
  elif pacman -Si "$pkg" >/dev/null 2>&1; then
    installer=(sudo pacman -S --needed)
    source="pacman"
  else
    bad "$pkg ${DIM}is missing, it is not in the repos, and neither yay nor paru is installed${RESET}"
    info "install an AUR helper, or install $pkg yourself, then run this again"
    return 0
  fi

  work "$pkg ${DIM}installing with $source${RESET}"
  printf '\n'
  if "${installer[@]}" "$pkg"; then
    printf '\n'
    ok "$pkg ${DIM}installed${RESET}"
  else
    printf '\n'
    bad "$pkg ${DIM}could not be installed with $source${RESET}"
  fi
}

ensure_package hyprmon-bin hyprmon
ensure_package todoist-appimage todoist
ensure_package networkmanager nmcli

# ---------------------------------------------------------------------------
# Plugins
#
# shell.json decides which plugins are on, and this repo tracks it -- so the
# configuration always arrives. What does not arrive is the code of a
# third-party plugin, which lives in a git clone under ~/.config/omarchy/
# plugins/ and is not tracked here. Without this step a new machine gets a
# shell.json that references a plugin it does not have.
#
# omarchy-plugin-add fails when the plugin is already present, and this script
# runs under `set -e`, so test for the directory first rather than letting a
# second run abort the script.
# ---------------------------------------------------------------------------

heading "Plugins"

install_plugins() {
  local manifest="plugins.txt" dir="$HOME/.config/omarchy/plugins"
  local id url output

  if [[ ! -f $manifest ]]; then
    info "no plugins.txt, nothing to install"
    return 0
  fi

  if ! command -v omarchy-plugin-add >/dev/null; then
    warn "omarchy-plugin-add not found, skipping plugins"
    return 0
  fi

  while read -r id url _; do
    [[ -z $id || $id == \#* ]] && continue

    if [[ -e "$dir/$id" ]]; then
      ok "$id ${DIM}already installed${RESET}"
    else
      work "$id ${DIM}installing from $url${RESET}"
      if output=$(omarchy-plugin-add "$url" --yes 2>&1); then
        ok "$id ${DIM}installed${RESET}"
      else
        bad "$id ${DIM}could not be installed from $url${RESET}"
        printf '%s\n' "$output" | sed "s/^/      ${DIM}/;s/\$/${RESET}/" >&2
      fi
    fi
  done <"$manifest"
}

install_plugins

# ---------------------------------------------------------------------------
# Setup scripts
#
# setup/ holds scripts that change the system rather than $HOME: the Plymouth
# boot screen, for example, which lives in /usr/share and is baked into the
# initramfs. They need sudo and they are slow, so they must not run on every
# bootstrap.
#
# Each script is therefore fingerprinted. The hash covers the script and every
# sibling file whose name starts with the script's name -- so setup/plymouth is
# hashed together with setup/plymouth-logo.png, and changing either one causes
# a re-run. The hash of the last successful run is kept in .state/, which is
# gitignored: it describes this machine, not the repo. A fresh clone has no
# .state/, so every script runs once on a new machine.
#
# Because the hashes decide everything before any privileged work starts, a
# bootstrap with nothing to apply never asks for a password: sudo is claimed
# lazily, on the first script that is actually going to run.
#
# Pass --force-setup to run them whatever the hashes say.
# ---------------------------------------------------------------------------

# Claim a sudo timestamp the first time a setup script actually has work to do,
# and remember the answer so the rest of the run reuses it.
#
# Working out what needs to run is only hashing and file reads, so the usual
# bootstrap -- where every script is unchanged -- never reaches this and never
# asks for a password.
#
# Claiming it up front still matters once there is work: it keeps the prompt out
# of the middle of a slow run, and a run with no terminal to ask on -- a pipe, a
# cron job -- would otherwise leave sudo waiting for a password that can never
# arrive, hanging the whole bootstrap instead of failing.
setup_sudo=unclaimed

ensure_setup_sudo() {
  case $setup_sudo in
    ready) return 0 ;;
    failed) return 1 ;;
  esac

  if sudo -n true 2>/dev/null; then
    setup_sudo=ready
    return 0
  fi

  if [[ ! -t 0 ]]; then
    warn "setup/ needs sudo, and there is no terminal to ask for a password on"
    info "run ./bootstrap from a terminal to apply them"
    setup_sudo=failed
    return 1
  fi

  info "the scripts below need root"
  if ! sudo -v; then
    bad "could not get sudo; skipping setup scripts"
    setup_sudo=failed
    return 1
  fi

  setup_sudo=ready
}

run_setup_scripts() {
  local state_dir=".state" script name hash stored

  if [[ ! -d setup ]]; then
    info "no setup/ directory"
    return 0
  fi

  shopt -s nullglob
  local scripts=(setup/*)
  shopt -u nullglob

  for script in "${scripts[@]}"; do
    [[ -f $script && -x $script ]] || continue
    name=$(basename "$script")

    # The script plus its assets. Glob order is sorted, so this is stable.
    hash=$(cat "setup/$name"* | sha256sum | cut -d' ' -f1)
    stored=$(cat "$state_dir/$name.sha256" 2>/dev/null || true)

    if [[ $force_setup -eq 0 && $hash == "$stored" ]]; then
      ok "$name ${DIM}unchanged since last run${RESET}"
      continue
    fi

    # Past this point the script is going to run, so this is the first moment
    # root is genuinely needed.
    ensure_setup_sudo || return 0

    if [[ $hash == "$stored" ]]; then
      work "$name ${DIM}forced${RESET}"
    elif [[ -n $stored ]]; then
      work "$name ${DIM}changed, re-running${RESET}"
    else
      work "$name ${DIM}has not run on this machine yet${RESET}"
    fi

    if "./$script"; then
      mkdir -p "$state_dir"
      printf '%s\n' "$hash" >"$state_dir/$name.sha256"
      ok "$name ${DIM}applied${RESET}"
    else
      bad "$name ${DIM}failed; it will run again next time${RESET}"
    fi
  done
}

heading "Setup"
run_setup_scripts

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------

printf '\n'
rule
if [[ $problems -eq 0 ]]; then
  printf '  %s %s\n\n' "${GREEN}✓${RESET}" "${BOLD}${GREEN}All done, no issues.${RESET}"
  printf '  %s\n\n' "${DIM}If Hyprland config changed: hyprctl reload && hyprctl configerrors${RESET}"
  exit 0
else
  printf '  %s %s\n\n' "${RED}✗${RESET}" "${BOLD}${RED}Finished with $problems problem(s).${RESET}"
  printf '  %s\n\n' "${DIM}Everything else was applied. See the messages above.${RESET}"
  exit 1
fi
