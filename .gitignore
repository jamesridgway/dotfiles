# Omarchy writes timestamped backups next to configs it replaces during
# updates and migrations. Never track those.
*.bak
*.bak.*
*.omarchy-upgrade-to-*.bak
*.sample

# Omarchy-managed symlinks, regenerated on `omarchy theme set`.
omarchy/.config/omarchy/current/

# Editor and OS noise
*.swp
.DS_Store
.lazy.lua

# ~/.ssh holds private keys and known_hosts. Track the config file and nothing
# else, so a stray key can never be committed by accident.
ssh/.ssh/*
!ssh/.ssh/config

# Third-party plugins are git clones. plugins.txt records their URLs instead.
omarchy/.config/omarchy/plugins/
