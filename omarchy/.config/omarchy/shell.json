        {
          "id": "omarchy.elsewhen"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "jamesridgway.woocommerce"
        },
        {
          "id": "omarchy.tray",
